    {
      "inputs": ["blocks"],
      "name": "building_attrs",
      "parms": {
        "snippet": "// Random building footprint, height and color per point\nfloat r = rand(@ptnum * 1.37);\nfloat centre = 1 - clamp(length(@P) / 8, 0, 1);\nfloat h = 0.3 + pow(r, 3) * 4 * centre + centre * 1.2;\n@scale = set(0.62, h, 0.62);\n@Cd = hsvtorgb(set(0.58 + rand(@ptnum + 7) * 0.08, 0.25, 0.55 + r * 0.4));\n"
      },
      "type": "attribwrangle",
      "x": 0,
      "y": 92
    },
    {
      "inputs": [],
      "name": "building",
      "parms": {
        "t": [0, 0.5, 0]
      },
      "type": "box",
      "x": 350,
      "y": 0
    },
    {
      "inputs": ["building", "building_attrs"],
      "name": "copy_buildings",
      "parms": {
        "useN": 0
      },
